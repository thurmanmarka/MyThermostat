[Unit]
Description=MyThermostat - American Standard thermostat through the American Standard Home cloud
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=myhomeservices
Group=myhomeservices
WorkingDirectory=/home/myhomeservices/MyThermostat
ExecStart=/home/myhomeservices/MyThermostat/MyThermostat
Restart=on-failure
RestartSec=10s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# Logging (changes and readings also go to the database)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thermostat

[Install]
WantedBy=multi-user.target
